# 複製成 .env 後填入。key 只放這個檔案（已被 git 忽略），任何情況都不要貼進對話。
# 監控清單請改 watchlist.txt，不在這裡。

# OpenAI（模型名稱未經聯網核實，預設 astra；實際名稱確認後在這裡改）
# 不填 key = 完全不用 AI，機械信號照常運行
OPENAI_API_KEY=
OPENAI_MODEL=astra
# 若用相容 OpenAI 格式的其他服務才需要改
OPENAI_BASE_URL=https://api.openai.com/v1

# Telegram 推送（可選）：找 @BotFather 建 bot 拿 token，chat_id 找 @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 門檻（%）
INTRADAY_CHANGE_PCT=3.0
LEV_INTRADAY_CHANGE_PCT=6.0
LEV_STOP_PCT=5.0
EARNINGS_WARN_DAYS=5
